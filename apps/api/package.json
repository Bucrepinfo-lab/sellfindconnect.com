{
  "name": "@telpen/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run build -w @telpen/domain && npm run generate -w @telpen/database && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "npm run build -w @telpen/domain && tsc -p tsconfig.json --noEmit",
    "test": "npm run build -w @telpen/domain && vitest run"
  },
  "dependencies": {
    "@nestjs/common": "11.1.27",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.27",
    "@nestjs/platform-express": "11.1.27",
    "@nestjs/swagger": "11.4.4",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@telpen/domain": "*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.2.0",
    "pg": "^8.21.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.23",
    "@types/express": "5.0.6",
    "@types/node": "25.9.3",
    "@types/swagger-ui-express": "4.1.8",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
