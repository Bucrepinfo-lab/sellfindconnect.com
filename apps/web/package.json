{
  "name": "@telpen/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-ocr-assets.mjs && next dev",
    "build": "npm run build -w @telpen/domain && node scripts/copy-ocr-assets.mjs && cross-env NODE_ENV=production next build",
    "start": "next start",
    "typecheck": "npm run build -w @telpen/domain && tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@telpen/domain": "*",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/swa": "1.0.0",
    "lucide-react": "1.18.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-easy-crop": "6.2.5",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.9",
    "typescript": "6.0.3"
  }
}
