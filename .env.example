NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telpen_adverts
AUTH_REPOSITORY=memory
PROFILE_REPOSITORY=memory
ANALYTICS_REPOSITORY=memory
INTERNAL_JOB_KEY=replace-with-a-long-random-secret

# --- Finance / payments (Epic 8) ---
# Payment provider selector. "manual" (default) uses the offline development
# adapter. Approve and wire a real provider before setting anything else.
PAYMENT_PROVIDER=manual
# When a live provider is enabled, configure its credentials here, e.g.:
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Optional infra for production (see docs/DIGITALOCEAN_DEPLOYMENT.md) ---
# REDIS_URL=redis://localhost:6379
# Media object storage (S3-compatible, e.g. DigitalOcean Spaces):
# MEDIA_STORAGE_DRIVER=s3
# MEDIA_S3_ENDPOINT=
# MEDIA_S3_REGION=
# MEDIA_S3_BUCKET=
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_PUBLIC_BASE_URL=
# Durable media job queue + production repositories:
# MEDIA_JOB_QUEUE_DRIVER=prisma
# AUTH_REPOSITORY=prisma
# PROFILE_REPOSITORY=prisma
# ANALYTICS_REPOSITORY=prisma
