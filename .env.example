# SellFindConnect - Environment Variables Reference
# Copy to .env and fill in real values. Never commit .env to git.

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/sellfindconnect?sslmode=require
FINANCE_REPOSITORY=prisma
ANALYTICS_REPOSITORY=prisma
AUTH_REPOSITORY=prisma
PROFILE_REPOSITORY=prisma
ADVERT_REPOSITORY=prisma
RELATIONSHIPS_REPOSITORY=prisma
CONVERSATIONS_REPOSITORY=prisma
SOURCE_FINDER_REPOSITORY=prisma
NOTIFICATIONS_REPOSITORY=prisma
MEDIA_JOB_QUEUE_DRIVER=prisma
MEDIA_ASSET_RESULT_PUBLISHER_DRIVER=prisma
PRIVACY_REPOSITORY=prisma

# ── Redis ────────────────────────────────────────────────
REDIS_URL=rediss://default:password@host:25061

# ── Object Storage (DigitalOcean Spaces) ─────────────────
# Live uploads overlay when these are set. MEDIA_STORAGE_DRIVER=development keeps local URLs.
# MEDIA_STORAGE_DRIVER=spaces fail-closes without the keys below.
MEDIA_STORAGE_DRIVER=
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
SPACES_ENDPOINT=https://sellfindconnect-media.fra1.digitaloceanspaces.com
SPACES_CDN_ENDPOINT=https://sellfindconnect-media.fra1.cdn.digitaloceanspaces.com
SPACES_BUCKET=sellfindconnect-media
MEDIA_S3_REGION=fra1

# ── Approved media scanners (optional overlay) ───────────
# Development processors stay default. Named providers fail-close without keys.
CLAMAV_SCAN_URL=
MEDIA_MALWARE_SCAN_PROVIDER=
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
MEDIA_CONTENT_MODERATION_PROVIDER=

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=
MFA_ISSUER=SellFindConnect
# TOTP authenticator enrollment uses MFA_ISSUER in the otpauth URI.
# Confirm with POST /v1/auth/mfa/totp/enroll then /mfa/totp/confirm.

# ── Email - Resend (https://resend.com) ──────────────────
# Notifications overlay Resend when these are set. Auth verification, password
# reset, tenant invites, and email MFA use the same keys.
# AUTH_EMAIL_PROVIDER=resend fail-closes without credentials.
# AUTH_EMAIL_PROVIDER=development keeps in-process tokens even if keys are set.
AUTH_EMAIL_PROVIDER=
RESEND_API_KEY=re_
EMAIL_FROM=SellFindConnect <no-reply@sellfindconnect.com>

# ── SMS - Africa's Talking (https://africastalking.com) ──
AT_API_KEY=
AT_USERNAME=sellfindconnect
AT_SENDER_ID=SFC

# ── WhatsApp notifications (optional overlay) ────────────
# Default: memory adapter. Set WHATSAPP_PROVIDER to fail-close without keys.
# WHATSAPP_PROVIDER=meta | africastalking
WHATSAPP_PROVIDER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
AT_WHATSAPP_FROM=
AT_WHATSAPP_PRODUCT_ID=

# ── Push - Firebase Cloud Messaging v1 ───────────────────
# Generate: Firebase Console > Project Settings > Service Accounts > Generate key
# Encode:   base64 -i serviceAccount.json
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# ── Search - OpenAI Embeddings (optional) ────────────────
# If absent, search runs in FTS-only mode (still works, no semantic matching)
OPENAI_API_KEY=

# ── Payment adapters (finance invoice capture) ───────────
# Default: manual development adapter (no network, no card data).
# PAYMENT_PROVIDER=stripe | africastalking | live
PAYMENT_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_API_BASE=https://api.stripe.com
AT_PAYMENTS_PRODUCT_NAME=
AT_PAYMENTS_CALLBACK_SECRET=

# ── Payment - M-Pesa Daraja ──────────────────────────────
DARAJA_BASE_URL=https://api.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=https://api.sellfindconnect.com/v1/payments/mpesa/callback

# ── Scheduled Jobs ───────────────────────────────────────
# Must match INTERNAL_JOB_KEY in GitHub Actions secrets
INTERNAL_JOB_KEY=

# ── App ──────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_URL=https://api.sellfindconnect.com
WEB_URL=https://sellfindconnect.com
WEB_ORIGIN=https://sellfindconnect.com
NEXT_PUBLIC_API_URL=https://api.sellfindconnect.com
NEXT_PUBLIC_CDN_URL=https://sellfindconnect-media.fra1.cdn.digitaloceanspaces.com
