generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  TRIAL_PENDING
  TRIAL_ACTIVE
  TRIAL_ENDING
  ACTIVE_PAID
  PAYMENT_FAILED
  GRACE_PERIOD
  CANCELED
  EXPIRED
  SUSPENDED
  REFUNDED
}

enum TenantRole {
  OWNER
  ADMIN
  EDITOR
  SALES_CHAT_AGENT
  BILLING_MANAGER
  ANALYTICS_VIEWER
  READ_ONLY_VIEWER
}

enum ProfileStatus {
  DRAFT
  PENDING_REVIEW
  LIVE
  RENEWAL_DUE
  PAUSED
  EXPIRED
  AUTO_DELETED
  ARCHIVED
  REJECTED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
}

enum NotificationDeliveryStatus {
  QUEUED
  SUPPRESSED
  SENT
  FAILED
}

enum NotificationConsentState {
  GRANTED
  DENIED
  REQUIRED
  NOT_REQUIRED
}

enum PolicyAction {
  ALLOW
  BLOCK
  REVIEW
  ESCALATE
}

enum FinanceAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  OVERDUE
}

enum TaxReturnStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  FILED
  REMITTED
  LOCKED
  CORRECTION_REQUIRED
}

enum TaxRemittanceStatus {
  PENDING
  APPROVED
  SUBMITTED
  PAID
  OVERDUE
  FAILED
}

enum AnalyticsEventType {
  IMPRESSION
  VIEW
  CLICK
  INQUIRY
  SHARE
  DOWNLOAD
  SAVE
  SEARCH
  MATCH
  CHAT_MESSAGE
  RESPONSE_TIME
}

enum AnalyticsEntityType {
  PROFILE
  LISTING
  SEARCH_RESULT
  MATCH
  CHAT_THREAD
  MEDIA_ASSET
}

enum ConversationStatus {
  OPEN
  ASSIGNED
  WAITING_ON_ADVERTISER
  WAITING_ON_REQUESTER
  RESOLVED
  BLOCKED
}

enum ConversationParticipantRole {
  REQUESTER
  ADVERTISER
  TENANT_AGENT
  SYSTEM
}

enum ConversationNotificationType {
  NEW_CONVERSATION
  NEW_MESSAGE
  ASSIGNMENT
  SLA_DUE_SOON
  SLA_BREACHED
}

enum ConsentState {
  GRANTED
  DENIED
  NOT_REQUIRED
  UNKNOWN
}

model Continent {
  code      String    @id @db.VarChar(8)
  name      String    @db.VarChar(80)
  countries Country[]
}

model Country {
  code                      String              @id @db.VarChar(2)
  name                      String              @db.VarChar(120)
  flagEmoji                 String              @db.VarChar(16)
  continentCode             String              @db.VarChar(8)
  currencyCode              String              @db.VarChar(3)
  currencyName              String              @db.VarChar(80)
  locale                    String              @db.VarChar(24)
  timezone                  String              @db.VarChar(80)
  monthlySubscriptionAmount Decimal             @db.Decimal(18, 4)
  isPilot                   Boolean             @default(false)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  continent                 Continent           @relation(fields: [continentCode], references: [code])
  tenants                   Tenant[]
  profileDrafts             ProfileDraft[]
  publishedProfiles         PublishedProfile[]
  advertDrafts              AdvertDraft[]
  publishedAdverts          PublishedAdvert[]
  taxProfiles               CountryTaxProfile[]

  @@index([continentCode])
}

model IndustryCategory {
  code        String   @id @db.VarChar(80)
  name        String   @db.VarChar(160)
  description String
  isBlocked   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                      String                    @id @default(uuid())
  email                   String                    @unique @db.VarChar(320)
  displayName             String                    @db.VarChar(160)
  phone                   String?                   @db.VarChar(80)
  passwordHash            String?
  passwordSalt            String?
  passwordIterations      Int?
  emailVerifiedAt         DateTime?
  phoneVerifiedAt         DateTime?
  mfaRequired             Boolean                   @default(false)
  mfaEnrolledAt           DateTime?
  lastMfaVerifiedAt       DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  memberships             TenantMembership[]
  auditLogs               AuditLog[]
  financeAlerts           FinanceAlert[]            @relation("FinanceAlertAssignee")
  assignedConversations   Conversation[]            @relation("ConversationAssignee")
  accessAssignments       AccessAssignment[]
  authSessions            AuthSession[]
  authMfaChallenges       AuthMfaChallenge[]
  authAccountChallenges   AuthAccountChallenge[]
  sentTenantInvites       TenantInvite[]            @relation("TenantInviteInviter")
  termsAcceptanceEvidence TermsAcceptanceEvidence[]
}

model Tenant {
  id                           String                        @id @default(uuid())
  displayName                  String                        @db.VarChar(160)
  legalName                    String?                       @db.VarChar(240)
  countryCode                  String                        @db.VarChar(2)
  primaryIndustryCode          String?                       @db.VarChar(80)
  primaryRole                  String?                       @db.VarChar(80)
  onboardingUserType           String?                       @db.VarChar(80)
  status                       TenantStatus                  @default(TRIAL_PENDING)
  trialStartedAt               DateTime?
  trialEndsAt                  DateTime?
  paidStartedAt                DateTime?
  renewalDate                  DateTime?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  country                      Country                       @relation(fields: [countryCode], references: [code])
  memberships                  TenantMembership[]
  profileDrafts                ProfileDraft[]
  publishedProfiles            PublishedProfile[]
  advertDrafts                 AdvertDraft[]
  publishedAdverts             PublishedAdvert[]
  relationshipClaims           RelationshipClaim[]
  savedSourceFinderSearches    SavedSourceFinderSearch[]
  sourceFinderOpportunityAlerts SourceFinderOpportunityAlert[]
  sourceFinderOutcomeFeedback  SourceFinderOutcomeFeedback[]
  advertLifecycleNotifications AdvertLifecycleNotification[]
  advertDiscoveryIndexes       AdvertDiscoveryIndex[]
  savedAdvertSearches          SavedAdvertSearch[]
  advertDiscoveryAlerts        AdvertDiscoveryAlert[]
  mediaAssets                  MediaAsset[]
  taxSnapshots                 TaxCalculationSnapshot[]
  analyticsEvents              AnalyticsEvent[]
  analyticsDailyRollups        AnalyticsDailyRollup[]
  auditLogs                    AuditLog[]
  notifications                Notification[]
  conversations                Conversation[]
  conversationMessages         ConversationMessage[]
  conversationNotifications    ConversationNotification[]
  notificationPreferences      NotificationPreference[]
  notificationOutboxRecords    NotificationOutboxRecord[]
  mediaProcessingJobs          MediaProcessingJob[]
  mediaReviewCases             MediaReviewCase[]
  accessAssignments            AccessAssignment[]
  accessDecisionAudits         AccessDecisionAudit[]
  authSessions                 AuthSession[]
  authMfaChallenges            AuthMfaChallenge[]
  tenantInvites                TenantInvite[]
  termsAcceptanceEvidence      TermsAcceptanceEvidence[]

  @@index([countryCode])
  @@index([status])
}

model TenantMembership {
  id        String     @id @default(uuid())
  tenantId  String
  userId    String
  role      TenantRole
  createdAt DateTime   @default(now())
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model TenantInvite {
  id              String    @id @default(uuid())
  tenantId        String
  email           String    @db.VarChar(320)
  role            String    @db.VarChar(80)
  tokenHash       String    @unique
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy       User      @relation("TenantInviteInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([email, tenantId])
  @@index([expiresAt, acceptedAt, revokedAt])
}

model AuthSession {
  id            String             @id @default(uuid())
  userId        String
  tenantId      String
  tokenHash     String             @unique
  role          String             @db.VarChar(80)
  mfaRequired   Boolean            @default(true)
  mfaVerified   Boolean            @default(false)
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime           @default(now())
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mfaChallenges AuthMfaChallenge[]

  @@index([userId, tenantId])
  @@index([expiresAt, revokedAt])
}

model AuthMfaChallenge {
  id              String      @id @default(uuid())
  sessionId       String
  userId          String
  tenantId        String
  codeHash        String
  deliveryChannel String      @db.VarChar(40)
  expiresAt       DateTime
  consumedAt      DateTime?
  failedAttempts  Int         @default(0)
  createdAt       DateTime    @default(now())
  session         AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([sessionId, consumedAt, expiresAt])
  @@index([userId, createdAt])
  @@index([tenantId, createdAt])
}

model AuthAccountChallenge {
  id         String    @id @default(uuid())
  userId     String
  email      String    @db.VarChar(320)
  phone      String?   @db.VarChar(80)
  purpose    String    @db.VarChar(40)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([purpose, expiresAt])
}

model TermsAcceptanceEvidence {
  id                       String   @id @default(uuid())
  userId                   String
  tenantId                 String
  countryCode              String   @db.VarChar(2)
  locale                   String   @db.VarChar(24)
  termsVersion             String   @db.VarChar(80)
  privacyVersion           String   @db.VarChar(80)
  prohibitedContentVersion String   @db.VarChar(80)
  subscriptionTermsVersion String   @db.VarChar(80)
  appSurface               String   @db.VarChar(40)
  acceptanceSource         String   @db.VarChar(80)
  acceptedAt               DateTime
  ipHash                   String?
  deviceHash               String?
  createdAt                DateTime @default(now())
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant                   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, tenantId])
  @@index([tenantId, acceptedAt])
  @@index([countryCode, acceptedAt])
}

model AccessAssignment {
  id             String    @id @default(uuid())
  userId         String
  tenantId       String?
  role           String    @db.VarChar(80)
  scopeLevel     String    @db.VarChar(40)
  regionCode     String?   @db.VarChar(40)
  continentCode  String?   @db.VarChar(8)
  countryCode    String?   @db.VarChar(2)
  scopedTenantId String?
  mfaRequired    Boolean   @default(true)
  assignedBy     String?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant         Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, role])
  @@index([tenantId, role])
  @@index([scopeLevel, regionCode, continentCode, countryCode])
  @@index([scopedTenantId])
  @@index([revokedAt, expiresAt])
}

model AccessDecisionAudit {
  id                  String   @id @default(uuid())
  tenantId            String?
  actorUserId         String   @db.VarChar(120)
  role                String   @db.VarChar(80)
  permission          String   @db.VarChar(80)
  scopeLevel          String   @db.VarChar(40)
  allowed             Boolean
  reason              String   @db.VarChar(80)
  targetTenantId      String?
  targetCountryCode   String?  @db.VarChar(2)
  targetContinentCode String?  @db.VarChar(8)
  targetRegionCode    String?  @db.VarChar(40)
  createdAt           DateTime @default(now())
  tenant              Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([allowed, reason])
  @@index([targetCountryCode, targetRegionCode])
}

model ProfileDraft {
  id                String        @id @default(uuid())
  tenantId          String
  countryCode       String        @db.VarChar(2)
  industryCode      String        @db.VarChar(80)
  role              String        @db.VarChar(80)
  displayName       String        @db.VarChar(160)
  description       String
  phone             String?       @db.VarChar(80)
  whatsapp          String?       @db.VarChar(80)
  email             String?       @db.VarChar(320)
  website           String?       @db.VarChar(500)
  physicalAddress   String?       @db.VarChar(500)
  mapsUrl           String?       @db.VarChar(500)
  socialLinks       Json?
  serviceArea       Json?
  status            ProfileStatus @default(DRAFT)
  reviewReasons     Json?
  reviewRequestedAt DateTime?
  reviewDecision    String?       @db.VarChar(40)
  reviewedAt        DateTime?
  reviewedBy        String?       @db.VarChar(120)
  reviewNote        String?       @db.VarChar(1000)
  version           Int           @default(1)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  country           Country       @relation(fields: [countryCode], references: [code])

  @@index([tenantId, status])
  @@index([reviewDecision])
  @@index([countryCode, industryCode])
}

model PublishedProfile {
  id               String        @id @default(uuid())
  tenantId         String
  sourceDraftId    String?
  countryCode      String        @db.VarChar(2)
  industryCode     String        @db.VarChar(80)
  role             String        @db.VarChar(80)
  displayName      String        @db.VarChar(160)
  description      String
  phone            String?       @db.VarChar(80)
  whatsapp         String?       @db.VarChar(80)
  email            String?       @db.VarChar(320)
  website          String?       @db.VarChar(500)
  physicalAddress  String?       @db.VarChar(500)
  mapsUrl          String?       @db.VarChar(500)
  socialLinks      Json?
  serviceArea      Json?
  status           ProfileStatus @default(LIVE)
  version          Int
  publishedAt      DateTime      @default(now())
  expiresAt        DateTime?
  renewalAlert35At DateTime?
  renewalAlert39At DateTime?
  archivedAt       DateTime?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  country          Country       @relation(fields: [countryCode], references: [code])

  @@index([tenantId, status])
  @@index([sourceDraftId])
  @@index([status, expiresAt])
  @@index([countryCode, industryCode])
}

model AdvertDraft {
  id           String    @id @default(uuid())
  tenantId     String
  countryCode  String    @db.VarChar(2)
  industryCode String    @db.VarChar(80)
  role         String    @db.VarChar(80)
  title        String    @db.VarChar(160)
  displayName  String    @db.VarChar(160)
  description  String
  phone        String?   @db.VarChar(80)
  email        String?   @db.VarChar(320)
  website      String?   @db.VarChar(500)
  status       String    @default("DRAFT") @db.VarChar(40)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  country      Country   @relation(fields: [countryCode], references: [code])

  @@index([tenantId, status])
  @@index([countryCode, industryCode])
}

model PublishedAdvert {
  id                String    @id @default(uuid())
  tenantId          String
  sourceDraftId     String?
  countryCode       String    @db.VarChar(2)
  industryCode      String    @db.VarChar(80)
  role              String    @db.VarChar(80)
  title             String    @db.VarChar(160)
  displayName       String    @db.VarChar(160)
  description       String
  phone             String?   @db.VarChar(80)
  email             String?   @db.VarChar(320)
  website           String?   @db.VarChar(500)
  status            String    @default("LIVE") @db.VarChar(40)
  version           Int       @default(1)
  publishedAt       DateTime
  expiresAt         DateTime
  boostedAt         DateTime?
  boostExpiresAt    DateTime?
  boostWeight       Int?
  renewalAlertsSent Json?
  pausedAt          DateTime?
  archivedAt        DateTime?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  country           Country   @relation(fields: [countryCode], references: [code])

  @@index([tenantId, status])
  @@index([sourceDraftId])
  @@index([status, expiresAt])
  @@index([status, boostExpiresAt])
  @@index([countryCode, industryCode])
}

model AdvertLifecycleNotification {
  id           String   @id @default(uuid())
  tenantId     String
  advertId     String   @db.VarChar(120)
  title        String   @db.VarChar(160)
  message      String
  scheduledFor DateTime
  day          Int
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([advertId, day])
  @@index([tenantId, scheduledFor])
}

model AdvertDiscoveryIndex {
  id                  String    @id @default(uuid())
  tenantId            String
  advertId            String    @db.VarChar(120)
  countryCode         String    @db.VarChar(2)
  industryCode        String    @db.VarChar(80)
  role                String    @db.VarChar(80)
  status              String    @db.VarChar(40)
  title               String    @db.VarChar(160)
  displayName         String    @db.VarChar(160)
  description         String
  searchText          String
  tokenVector         Json
  relationshipSignals Json?
  publishedAt         DateTime
  expiresAt           DateTime
  boostedAt           DateTime?
  boostExpiresAt      DateTime?
  boostWeight         Int?
  indexedAt           DateTime
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, advertId])
  @@index([countryCode, industryCode, role, status])
  @@index([status, indexedAt])
  @@index([tenantId, status, indexedAt])
}

model SavedAdvertSearch {
  id             String                 @id @default(uuid())
  tenantId       String
  name           String                 @db.VarChar(120)
  query          String                 @db.VarChar(240)
  countryCode    String?                @db.VarChar(2)
  industryCode   String?                @db.VarChar(80)
  role           String?                @db.VarChar(80)
  alertFrequency String                 @default("DAILY") @db.VarChar(40)
  isActive       Boolean                @default(true)
  lastAlertedAt  DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alerts         AdvertDiscoveryAlert[]

  @@index([tenantId, isActive])
  @@index([tenantId, updatedAt])
}

model AdvertDiscoveryAlert {
  id            String            @id @default(uuid())
  tenantId      String
  savedSearchId String
  advertId      String            @db.VarChar(120)
  title         String            @db.VarChar(160)
  message       String
  rankScore     Int
  reasonCodes   Json?
  createdAt     DateTime          @default(now())
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  savedSearch   SavedAdvertSearch @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)

  @@unique([savedSearchId, advertId])
  @@index([tenantId, createdAt])
}

model RelationshipClaim {
  id                   String    @id @default(uuid())
  tenantId             String
  sourceLabel          String    @db.VarChar(160)
  sourceRole           String    @db.VarChar(80)
  counterpartLabel     String    @db.VarChar(160)
  counterpartRole      String    @db.VarChar(80)
  counterpartTenantId  String?   @db.VarChar(120)
  relationship         String    @db.VarChar(40)
  visibility           String    @db.VarChar(40)
  status               String    @db.VarChar(40)
  note                 String?
  createdByUserId      String    @db.VarChar(120)
  decidedByUserId      String?   @db.VarChar(120)
  decidedAt            DateTime?
  decisionNote         String?
  removedByUserId      String?   @db.VarChar(120)
  removedAt            DateTime?
  removalReason        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([counterpartTenantId, status])
  @@index([status, visibility])
}

model SavedSourceFinderSearch {
  id             String                          @id @default(uuid())
  tenantId       String
  name           String                          @db.VarChar(120)
  query          String                          @db.VarChar(200)
  role           String?                         @db.VarChar(80)
  industryCode   String?                         @db.VarChar(80)
  countryCode    String?                         @db.VarChar(2)
  sortBy         String?                         @db.VarChar(40)
  alertFrequency String                          @default("DAILY") @db.VarChar(40)
  isActive       Boolean                         @default(true)
  lastAlertedAt  DateTime?
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt
  tenant         Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alerts         SourceFinderOpportunityAlert[]

  @@index([tenantId, isActive])
  @@index([tenantId, updatedAt])
}

model SourceFinderOpportunityAlert {
  id             String                   @id @default(uuid())
  tenantId       String
  savedSearchId  String
  sourceRecordId String                   @db.VarChar(120)
  sourceName     String                   @db.VarChar(200)
  sourceRole     String                   @db.VarChar(80)
  title          String                   @db.VarChar(160)
  message        String
  score          Int
  reasonCodes    Json?
  createdAt      DateTime                 @default(now())
  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  savedSearch    SavedSourceFinderSearch  @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)

  @@unique([savedSearchId, sourceRecordId])
  @@index([tenantId, createdAt])
}

model SourceFinderOutcomeFeedback {
  id                        String   @id @default(uuid())
  tenantId                  String
  sourceRecordId            String   @db.VarChar(120)
  query                     String?  @db.VarChar(200)
  action                    String   @db.VarChar(40)
  note                      String?  @db.VarChar(500)
  behavioralMatchingConsent Boolean  @default(false)
  createdAt                 DateTime @default(now())
  tenant                    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, sourceRecordId])
  @@index([tenantId, createdAt])
}

model SourceFinderIndex {
  id                  String   @id @default(uuid())
  sourceRecordId      String   @unique @db.VarChar(120)
  tenantId            String?  @db.VarChar(120)
  name                String   @db.VarChar(200)
  role                String   @db.VarChar(80)
  industryCode        String   @db.VarChar(80)
  countryCode         String   @db.VarChar(2)
  location            String   @db.VarChar(160)
  offers              Json
  needs               Json
  relatedLinks        Json
  verified            Boolean
  publishedAt         DateTime
  responseTimeMinutes Int
  analytics           Json
  searchText          String
  tokenVector         Json
  indexedAt           DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([countryCode, industryCode, role])
  @@index([indexedAt])
}

model MediaAsset {
  id               String   @id @default(uuid())
  tenantId         String
  ownerType        String   @db.VarChar(40)
  ownerId          String   @db.VarChar(120)
  kind             String   @db.VarChar(20)
  status           String   @db.VarChar(40)
  sourceUrl        String   @db.VarChar(1000)
  thumbnailUrl     String?  @db.VarChar(1000)
  mimeType         String   @db.VarChar(120)
  fileName         String   @db.VarChar(240)
  fileSizeBytes    Int
  width            Int?
  height           Int?
  durationSeconds  Int?
  caption          String?  @db.VarChar(500)
